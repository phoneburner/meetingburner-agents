# Copy to .env.local and fill in. Never commit .env.local.
# Create a key at meetingburner.com: Settings, Developer, Create API Key,
# and tick "Create meetings" (this starter creates one).
MEETINGBURNER_API_KEY=mb_your_key_here

# Required anywhere except `npm run dev`: every route refuses a caller that does
# not send this value, because the routes spend your MeetingBurner key. Use a
# long random value (openssl rand -hex 32). The page asks for it once.
STARTER_ACCESS_TOKEN=

# Optional: only change this to point at a different MeetingBurner deployment.
MEETINGBURNER_API_URL=https://meetingburner.com/api/v1
